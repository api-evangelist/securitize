{
  "opencollection": "1.0.0",
  "info": {
    "name": "Securitize Domains Health Check API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health Check",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AppController_root",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/health"
          },
          "docs": "For Health check"
        }
      ]
    }
  ],
  "bundled": true
}