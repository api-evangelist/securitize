{
  "opencollection": "1.0.0",
  "info": {
    "name": "Securitize Domains APAC API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "APAC",
        "type": "folder"
      },
      "items": [
        {
