            "name": "BankDepositFilesController_getBankDepositFile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/apac/domains/:domainId/tokens/:tokenId/bank-deposit-files/detail",
            "params": [
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              },
              {
                "name": "bankDepositFileId",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "BankDepositFilesController_createBankDepositFile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/apac/domains/:domainId/tokens/:tokenId/bank-deposit-files/detail",
            "params": [
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
