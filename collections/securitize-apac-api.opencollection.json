          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/apac/domains/:domainId/tokens/:tokenId/investment-requests/total-pledged-amounts",
            "params": [
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              }
            ]
          }
