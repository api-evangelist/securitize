            "name": "BankDepositFilesController_deleteBankDepositFile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/apac/domains/:domainId/tokens/:tokenId/bank-deposit-files/detail",
            "params": [
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "BankDepositFilesController_getBankDepositFiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/apac/domains/:domainId/tokens/:tokenId/bank-deposit-files/list",
            "params": [
              {
                "name": "domainId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              },
              {
                "name": "paymentYear",
                "value": "",
                "type": "query"
              },
              {
                "name": "paymentMonth",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "BankDepositFilesController_getBankDepositFileRecords",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/apac/domains/:domainId/tokens/:tokenId/bank-deposit-files/records",
            "params": [
